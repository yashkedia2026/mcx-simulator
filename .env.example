# Server only. Never prefix credentials with VITE_. These must be the
# Symphony Binary Marketdata API app key and app secret.
EUREKA_BASE_URL=https://algo.eurekasecurities.net
EUREKA_APP_KEY=
EUREKA_SECRET_KEY=
MARKET_DATA_PORT=3001

# Client-side Supabase project values. The anon key is safe to expose in the
# browser when Row-Level Security is enabled; never put a service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
